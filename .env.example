# CARTO basemap API key — required as of 2026 for the Positron basemap tiles
# used in src/lib/config/tiles.ts. Get one at https://carto.com/basemaps/apikey/
# and set it here (locally) and as a Vercel project environment variable
# (with the same name, so it's available at build/runtime there too).
PUBLIC_CARTO_API_KEY=
