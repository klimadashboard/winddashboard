// Cloudflare Worker für winddashboard.at (adapter-cloudflare, siehe svelte.config.js).
// Bauen und ausrollen:  npm run deploy
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "winddashboard",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// workers.dev-Adresse zum Testen behalten (winddashboard.web-19f.workers.dev).
	"workers_dev": true,
	"vars": {
		// Leer = Kacheln über den Proxy /tiles in diesem Worker. Sobald
		// tiles.winddashboard.at über den Cloudflare-Cache läuft, hier
		// "https://tiles.winddashboard.at" eintragen: dann zählen Kacheln
		// gar nicht mehr als Worker-Anfragen.
		"PUBLIC_TILE_BASE": ""
	},
	// Eigene Domains (Zone winddashboard.at liegt seit 24.11.2026 auf Cloudflare).
	// Cloudflare legt dafür selbst DNS-Einträge und Zertifikate an.
	// Vorübergehend aus: Cloudflare hängt die Domain erst an, wenn die von
	// Vercel übernommenen DNS-Einträge gelöscht sind — und ohne erfolgreiche
	// Domain-Anbindung aktiviert wrangler die neue Version gar nicht.
	"routes": []
	// PUBLIC_CARTO_API_KEY liegt als Secret im Worker (wrangler secret put),
	// wie in .env lokal; ins vorgerenderte HTML kommt er beim Build aus .env.
}
