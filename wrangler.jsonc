// Cloudflare Worker für winddashboard.at (adapter-cloudflare, siehe svelte.config.js).
// Bauen und ausrollen:  npm run deploy
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "winddashboard",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// workers.dev-Adresse zum Testen behalten (winddashboard.web-19f.workers.dev).
	"workers_dev": true,
	"vars": {
		// Kacheln direkt von tiles.winddashboard.at: CNAME auf den Kachelserver,
		// über Cloudflare geproxied, Cache-Regel "Eligible for cache" auf den
		// Hostnamen. So zählen Kacheln nicht als Worker-Anfragen. Wirkt erst
		// nach neuem Build (landet in /_app/env.js). Leer = Proxy /tiles.
		"PUBLIC_TILE_BASE": "https://tiles.winddashboard.at"
	},
	// Eigene Domains (Zone winddashboard.at liegt seit 24.11.2026 auf Cloudflare).
	// Cloudflare legt dafür selbst DNS-Einträge und Zertifikate an.
	"routes": [
		{ "pattern": "winddashboard.at", "custom_domain": true },
		{ "pattern": "www.winddashboard.at", "custom_domain": true }
	]
	// PUBLIC_CARTO_API_KEY liegt als Secret im Worker (wrangler secret put),
	// wie in .env lokal; ins vorgerenderte HTML kommt er beim Build aus .env.
}
